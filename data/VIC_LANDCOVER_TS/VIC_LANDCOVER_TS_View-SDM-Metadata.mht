/******************/
/*Global variables
/******************/

/***********************************************************************/=

/*Functions for updating the screen display flag of objects using Ajax =
*/
/***********************************************************************/=

function productSelect(element)
{
	var id;
	var flag;

	id =3D getIdIntegerFromIdString(element.id);
	flag =3D element.checked;

	var button =3D document.getElementById ('sdmProceedOrderButton1');
//	console.log ("button1 =3D " + button + "  disabled was =3D " + =
button.disabled);
	if (button) button.disabled =3D true;
//	console.log ("button1 =3D " + button + "  disabled now =3D " + =
button.disabled);

	button =3D document.getElementById ('sdmProceedOrderButton2');
//	console.log ("button2 =3D " + button + "  disabled was =3D " + =
button.disabled);
	if (button) button.disabled =3D true;
//	console.log ("button2 =3D " + button + "  disabled now =3D " + =
button.disabled);


	ProductSelectionService.updateProductOrderSelection(id, flag, =
handleUpdate);

}

function productPreview(element, executeTool)
{
	var id;
	var flag;

	id =3D getIdIntegerFromIdString(element.id);
	flag =3D element.checked;

	var button =3D document.getElementById ('sdmSearchPreviewButton');
//	console.log ("buttonp =3D " + button + "  disabled was =3D " + =
button.disabled);
	if (button) button.disabled =3D true;
//	console.log ("buttonp =3D " + button + "  disabled now =3D " + =
button.disabled);


	ProductSelectionService.updateProductPreviewSelection(id, flag, =
executeTool, handleUpdate);

}



function getIdIntegerFromIdString(idString)
{
	//Takes the id of the html element and gets the java object
	//id from the end of the string

	var pos =3D idString.indexOf("_");
	var id =3D idString.substr(pos+1);

	return(id);
}

function handleUpdate(result)
{

	var button =3D document.getElementById ('sdmProceedOrderButton1');
//	console.log ("button1 =3D " + button + "  disabled was =3D " + =
button.disabled);
	if (button) button.disabled =3D false;
//	console.log ("button1 =3D " + button + "  disabled now =3D " + =
button.disabled);

	button =3D document.getElementById ('sdmProceedOrderButton2');
//	console.log ("button2 =3D " + button + "  disabled was =3D " + =
button.disabled);
	if (button) button.disabled =3D false;
//	console.log ("button2 =3D " + button + "  disabled now =3D " + =
button.disabled);

	button =3D document.getElementById ('sdmSearchPreviewButton');
//	console.log ("buttonp =3D " + button + "  disabled was =3D " + =
button.disabled);
	if (button) button.disabled =3D false;
//	console.log ("buttonp =3D " + button + "  disabled now =3D " + =
button.disabled);


	if(result)
	{
		notifyUser(result);
	}
}


function notifyUser(result)
{
	if(result !=3D "")
	{
		var messageHolder =3D document.getElementById("messageHolder");
		if(messageHolder)
		{
			var messageType =3D "";
			var innerHTML =3D "";
			for(i=3D0; i<result.length; i++)
			{
				if(i =3D=3D 0)
				{
					messageType =3D result[i];
				}
				switch(result[i])
				{
					case "error":
						innerHTML =3D "<ul class=3D'errors'>";
						break;

					case "message":
						innerHTML =3D "<div class=3D'message'><ul>";
						break;

					default:
						innerHTML =3D innerHTML + "<li>" + result[i] + "</li>";
				}
			}

			switch(messageType)
			{
				case "error":
					innerHTML =3D innerHTML + "</ul>";
					break;

				case "message":
					innerHTML =3D innerHTML + "</ul></div>";
					break;

				default:
			}

			messageHolder.innerHTML =3D innerHTML;
		}
	}
}
