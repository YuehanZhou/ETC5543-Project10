<SCRIPT type=3D"text/javascript">=0A=
=0A=
function checkEmailAddress()=0A=
{=0A=
	if (arguments.length =3D=3D 1)=0A=
	{=0A=
		var e =3D arguments[0];=0A=
		var code =3D (e.keyCode ? e.keyCode : e.which);=0A=
		if(code !=3D 13) return false;=0A=
	}=0A=
=0A=
	var email1 =3D "";=0A=
	var email2 =3D "";=0A=
	var f =3D document.getElementById("email1");=0A=
	if (f) email1 =3D f.value;=0A=
	f =3D document.getElementById("email2");=0A=
	if (f) email2 =3D f.value;=0A=
	if (email1 =3D=3D "") =0A=
	{=0A=
		alert ("You must enter an email address");=0A=
		return false;=0A=
	}=0A=
	if (email2 =3D=3D "") =0A=
	{=0A=
		alert ("You must confirm the email address");=0A=
		return false;=0A=
	}=0A=
	if (email1 !=3D email2) =0A=
	{=0A=
		alert ("The two email addresses must be the same");=0A=
		return false;=0A=
	}=0A=
	if (! checkEmail(email1))=0A=
	{=0A=
		alert ("The email address doesn't appear to be valid");=0A=
		return false;=0A=
	}=0A=
	=0A=
	f =3D document.getElementById("email");=0A=
	if (f)=0A=
	{=0A=
		f.value =3D email1;=0A=
		f =3D document.forms['emailLogin'];=0A=
		if (f)=0A=
		{=0A=
//			alert ("submit " + email1 + " to " + f.action);=0A=
			f.submit();=0A=
		}=0A=
		else=0A=
			alert ("No form");	=0A=
	}	=0A=
	return false;=0A=
}=0A=
function checkEmail(emailAddress) {=0A=
  var sQtext =3D '[^\\x0d\\x22\\x5c\\x80-\\xff]';=0A=
  var sDtext =3D '[^\\x0d\\x5b-\\x5d\\x80-\\xff]';=0A=
  var sAtom =3D =
'[^\\x00-\\x20\\x22\\x28\\x29\\x2c\\x2e\\x3a-\\x3c\\x3e\\x40\\x5b-\\x5d\\=
x7f-\\xff]+';=0A=
  var sQuotedPair =3D '\\x5c[\\x00-\\x7f]';=0A=
  var sDomainLiteral =3D '\\x5b(' + sDtext + '|' + sQuotedPair + =
')*\\x5d';=0A=
  var sQuotedString =3D '\\x22(' + sQtext + '|' + sQuotedPair + =
')*\\x22';=0A=
  var sDomain_ref =3D sAtom;=0A=
  var sSubDomain =3D '(' + sDomain_ref + '|' + sDomainLiteral + ')';=0A=
  var sWord =3D '(' + sAtom + '|' + sQuotedString + ')';=0A=
  var sDomain =3D sSubDomain + '(\\x2e' + sSubDomain + ')*';=0A=
  var sLocalPart =3D sWord + '(\\x2e' + sWord + ')*';=0A=
  var sAddrSpec =3D sLocalPart + '\\x40' + sDomain; // complete RFC822 =
email address spec=0A=
  var sValidEmail =3D '^' + sAddrSpec + '$'; // as whole string=0A=
=0A=
=0A=
	var regex =3D =
"^[\\w!#$%&'*+/=3D?`{|}~^-]+(?:\\.[\\w!#$%&'*+/=3D?`{|}~^-]+)*@(?:[a-zA-Z=
0-9-]+\\.)+[a-zA-Z]{2,10}$";=0A=
		=0A=
  var reValidEmail =3D new RegExp(regex);=0A=
=0A=
  return reValidEmail.test(emailAddress);=0A=
}=0A=
</SCRIPT>
